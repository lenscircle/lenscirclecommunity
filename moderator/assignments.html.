
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#252722">
  <title>My Assignments | Lens Circle</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --paper: #f7f6f2;
      --white: #fff;
      --ink: #252722;
      --muted: #777970;
      --line: #e7e4dc;
      --accent: #a85e42;
      --accent-light: #f3e8e1;
      --sidebar: #252722;
      --serif: "Playfair Display", Georgia, serif;
      --sans: "DM Sans", Arial, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--paper);
      color: var(--ink);
      font-family: var(--sans);
      min-height: 100vh;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
    }

    .layout {
      display: flex;
      min-height: 100vh;
    }

    .sidebar {
      width: 245px;
      flex-shrink: 0;
      background: var(--sidebar);
      color: white;
      padding: 29px 20px;
      display: flex;
      flex-direction: column;
    }

    .brand {
      font: 700 25px var(--serif);
      padding: 0 10px;
    }

    .brand span {
      color: #d18b6d;
    }

    .portal-label {
      padding: 9px 10px 26px;
      color: #bcbdb5;
      font-size: 9px;
      letter-spacing: 1.7px;
      text-transform: uppercase;
    }

    .nav-heading {
      padding: 17px 10px 10px;
      color: #898b82;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .nav-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 11px;
      margin: 2px 0;
      border-radius: 4px;
      color: #d1d2cb;
      font-size: 11px;
    }

    .nav-link:hover,
    .nav-link.active {
      background: #393b34;
      color: white;
    }

    .nav-link.active {
      border-left: 3px solid #d18b6d;
      padding-left: 8px;
    }

    .nav-icon {
      width: 18px;
      text-align: center;
      color: #d18b6d;
      font-size: 14px;
    }

    .sidebar-bottom {
      margin-top: auto;
      padding-top: 25px;
    }

    .sidebar-note {
      padding: 15px;
      border: 1px solid #484a43;
      color: #bfc0b8;
      font-size: 10px;
      line-height: 1.8;
    }

    .sidebar-note strong {
      display: block;
      color: white;
      margin-bottom: 5px;
    }

    .main {
      flex: 1;
      min-width: 0;
    }

    .topbar {
      height: 75px;
      padding: 0 38px;
      background: white;
      border-bottom: 1px solid var(--line);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .breadcrumb {
      color: var(--muted);
      font-size: 10px;
    }

    .breadcrumb strong {
      color: var(--ink);
    }

    .role-badge {
      padding: 8px 11px;
      background: var(--accent-light);
      color: var(--accent);
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 1px;
    }

    .content {
      max-width: 1400px;
      margin: auto;
      padding: 40px;
    }

    .eyebrow {
      color: var(--accent);
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    h1 {
      font: 500 clamp(34px, 4vw, 44px)/1.15 var(--serif);
    }

    .intro {
      margin-top: 10px;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.8;
    }

    .page-heading {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 20px;
      margin-bottom: 30px;
    }

    .date {
      color: var(--muted);
      font-size: 10px;
      white-space: nowrap;
    }

    .notice {
      display: flex;
      gap: 13px;
      padding: 17px 19px;
      background: white;
      border: 1px solid var(--line);
      margin-bottom: 27px;
    }

    .notice-icon {
      color: var(--accent);
      font-size: 17px;
    }

    .notice strong {
      display: block;
      font-size: 11px;
      margin-bottom: 5px;
    }

    .notice p {
      color: var(--muted);
      font-size: 10px;
      line-height: 1.8;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
      margin-bottom: 30px;
    }

    .stat {
      background: white;
      border: 1px solid var(--line);
      padding: 21px;
    }

    .stat-label {
      color: var(--muted);
      font-size: 10px;
      margin-bottom: 15px;
    }

    .stat-value {
      font: 31px var(--serif);
    }

    .stat-foot {
      color: var(--muted);
      font-size: 9px;
      margin-top: 8px;
    }

    .toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      flex-wrap: wrap;
      margin-bottom: 16px;
    }

    .toolbar h2 {
      font: 500 23px var(--serif);
    }

    .filters {
      display: flex;
      gap: 9px;
      flex-wrap: wrap;
    }

    select,
    input {
      padding: 11px 13px;
      border: 1px solid var(--line);
      background: white;
      color: var(--ink);
      font-size: 10px;
      outline: none;
    }

    select:focus,
    input:focus {
      border-color: var(--accent);
    }

    .assignment-panel {
      background: white;
      border: 1px solid var(--line);
      padding: 25px;
    }

    .empty-state {
      text-align: center;
      padding: 55px 20px;
    }

    .empty-icon {
      width: 55px;
      height: 55px;
      margin: 0 auto 18px;
      border: 1px solid var(--line);
      border-radius: 50%;
      display: grid;
      place-items: center;
      color: var(--accent);
      font-size: 22px;
    }

    .empty-state h3 {
      font: 500 23px var(--serif);
      margin-bottom: 9px;
    }

    .empty-state p {
      max-width: 400px;
      margin: auto;
      color: var(--muted);
      font-size: 10px;
      line-height: 1.9;
    }

    .guidelines {
      margin-top: 25px;
      background: #efeee8;
      padding: 22px;
    }

    .guidelines h3 {
      font: 500 20px var(--serif);
      margin-bottom: 12px;
    }

    .guidelines ul {
      padding-left: 17px;
      color: #65665e;
      font-size: 10px;
      line-height: 2.1;
    }

    .footer {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      margin-top: 30px;
      padding: 20px 0;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 9px;
    }

    .logout {
      border: 0;
      background: transparent;
      color: var(--accent);
      font-size: 10px;
      font-weight: 700;
      cursor: pointer;
    }

    .loading-screen {
      position: fixed;
      inset: 0;
      z-index: 10;
      background: var(--paper);
      display: grid;
      place-items: center;
      text-align: center;
      padding: 25px;
    }

    .loading-screen h2 {
      font: 500 28px var(--serif);
      margin-bottom: 10px;
    }

    .loading-screen p {
      color: var(--muted);
      font-size: 11px;
      line-height: 1.8;
    }

    .hidden {
      display: none !important;
    }

    @media(max-width: 900px) {
      .sidebar {
        width: 215px;
      }

      .content {
        padding: 28px;
      }
    }

    @media(max-width: 700px) {
      .layout {
        display: block;
      }

      .sidebar {
        width: 100%;
        padding: 16px 18px;
      }

      .portal-label,
      .sidebar nav,
      .sidebar-bottom {
        display: none;
      }

      .topbar {
        height: 60px;
        padding: 0 20px;
      }

      .content {
        padding: 25px 18px;
      }

      .page-heading {
        display: block;
      }

      .date {
        display: block;
        margin-top: 14px;
      }

      .stats {
        gap: 10px;
      }

      .stat {
        padding: 15px;
      }

      .footer {
        flex-direction: column;
      }
    }

    @media(max-width: 430px) {
      .stats {
        grid-template-columns: 1fr;
      }

      .filters {
        width: 100%;
      }

      .filters select,
      .filters input {
        flex: 1;
        min-width: 0;
      }
    }
  </style>
</head>

<body>

  <div class="loading-screen" id="loadingScreen">
    <div>
      <h2>Verifying your access</h2>
      <p>Please wait while we check your moderator permissions.</p>
    </div>
  </div>

  <div class="layout hidden" id="app">

    <aside class="sidebar">

      <a href="../index.html" class="brand">
        Lens <span>Circle</span>
      </a>

      <div class="portal-label">Moderator workspace</div>

      <nav>
        <div class="nav-heading">Workspace</div>

        <a href="dashboard.html" class="nav-link">
          <span class="nav-icon">⌂</span>
          Dashboard
        </a>

        <a href="assignments.html" class="nav-link active">
          <span class="nav-icon">▤</span>
          My assignments
        </a>

        <div class="nav-heading">Community</div>

        <a href="submissions.html" class="nav-link">
          <span class="nav-icon">▧</span>
          Submissions
        </a>

        <a href="reports.html" class="nav-link">
          <span class="nav-icon">⚑</span>
          Community reports
        </a>

        <a href="members.html" class="nav-link">
          <span class="nav-icon">♧</span>
          Member directory
        </a>

        <div class="nav-heading">Activities</div>

        <a href="activities.html" class="nav-link">
          <span class="nav-icon">◎</span>
          Activities
        </a>

        <a href="competitions.html" class="nav-link">
          <span class="nav-icon">✧</span>
          Competitions
        </a>

        <div class="nav-heading">Account</div>

        <a href="profile.html" class="nav-link">
          <span class="nav-icon">◉</span>
          My profile
        </a>
      </nav>

      <div class="sidebar-bottom">
        <div class="sidebar-note">
          <strong>Work responsibly</strong>
          Complete assigned tasks accurately and escalate
          matters outside your permissions.
        </div>
      </div>

    </aside>

    <main class="main">

      <header class="topbar">
        <div class="breadcrumb">
          Lens Circle / Moderator / <strong>My assignments</strong>
        </div>

        <div class="role-badge">MODERATOR</div>
      </header>

      <div class="content">

        <section class="page-heading">
          <div>
            <div class="eyebrow">Your responsibilities</div>

            <h1>My assignments.</h1>

            <p class="intro">
              Review the work assigned to you, keep track of deadlines
              and maintain a clear record of your responsibilities.
            </p>
          </div>

          <div class="date" id="date"></div>
        </section>

        <section class="notice">
          <div class="notice-icon">✦</div>

          <div>
            <strong>Your assignment workspace is ready.</strong>

            <p>
              Live assignments will appear here after the
              administrator assignment system is connected.
              No tasks are being represented as active at this stage.
            </p>
          </div>
        </section>

        <section class="stats">

          <article class="stat">
            <div class="stat-label">Total assignments</div>
            <div class="stat-value">—</div>
            <div class="stat-foot">Database connection pending</div>
          </article>

          <article class="stat">
            <div class="stat-label">In progress</div>
            <div class="stat-value">—</div>
            <div class="stat-foot">Database connection pending</div>
          </article>

          <article class="stat">
            <div class="stat-label">Completed</div>
            <div class="stat-value">—</div>
            <div class="stat-foot">Database connection pending</div>
          </article>

        </section>

        <section>

          <div class="toolbar">
            <h2>Assignment list</h2>

            <div class="filters">
              <select id="statusFilter" aria-label="Filter by status">
                <option value="all">All statuses</option>
                <option value="pending">Pending</option>
                <option value="progress">In progress</option>
                <option value="completed">Completed</option>
              </select>

              <input
                type="search"
                id="search"
                placeholder="Search assignments..."
                aria-label="Search assignments"
                disabled>
            </div>
          </div>

          <div class="assignment-panel">

            <div class="empty-state">
              <div class="empty-icon">▤</div>

              <h3>No assignments yet.</h3>

              <p>
                When an administrator assigns a task to your
                account, it will appear here with its description,
                priority, deadline and current status.
              </p>
            </div>

          </div>

        </section>

        <section class="guidelines">

          <h3>Assignment management guidelines</h3>

          <ul>
            <li>Review the task description before beginning work.</li>
            <li>Respect the deadline and priority set by the administrator.</li>
            <li>Do not take actions outside your assigned permissions.</li>
            <li>Report blockers or unclear instructions to the administrator.</li>
            <li>Record completion only after the assigned work is genuinely finished.</li>
          </ul>

        </section>

        <footer class="footer">

          <span>
            © <span id="year"></span> Lens Circle · Moderator workspace
          </span>

          <button class="logout" id="logoutButton">
            Sign out securely →
          </button>

        </footer>

      </div>

    </main>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <script>
    const SUPABASE_URL = "YOUR_SUPABASE_PROJECT_URL";
    const SUPABASE_ANON_KEY = "YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY";

    const configured =
      SUPABASE_URL.startsWith("https://") &&
      !SUPABASE_URL.includes("YOUR_SUPABASE") &&
      SUPABASE_ANON_KEY.length > 20 &&
      !SUPABASE_ANON_KEY.includes("YOUR_SUPABASE");

    const client = configured && window.supabase
      ? window.supabase.createClient(
          SUPABASE_URL,
          SUPABASE_ANON_KEY,
          {
            auth: {
              persistSession: true,
              autoRefreshToken: true,
              detectSessionInUrl: true
            }
          }
        )
      : null;

    const loadingScreen = document.getElementById("loadingScreen");
    const app = document.getElementById("app");

    function showBlockingMessage(title, message) {
      loadingScreen.innerHTML = `
        <div>
          <h2>${title}</h2>
          <p>${message}</p>
          <p style="margin-top:22px;">
            <a href="login.html" style="color:#a85e42;font-weight:700;">
              Return to moderator sign in →
            </a>
          </p>
        </div>
      `;
    }

    async function verifyAccess() {
      if (!client) {
        showBlockingMessage(
          "Configuration required",
          "Configure Supabase before accessing this page."
        );
        return;
      }

      try {
        const { data, error } =
          await client.auth.getSession();

        if (error) throw error;

        if (!data.session) {
          window.location.replace("login.html");
          return;
        }

        const { data: authorised, error: roleError } =
          await client.rpc("has_staff_role", {
            required_role: "moderator"
          });

        if (roleError) {
          throw new Error(
            "Moderator permissions could not be verified."
          );
        }

        if (authorised !== true) {
          await client.auth.signOut();
          window.location.replace("login.html");
          return;
        }

        const now = new Date();

        document.getElementById("date").textContent =
          now.toLocaleDateString("en-IN", {
            weekday: "long",
            day: "numeric",
            month: "long",
            year: "numeric"
          });

        document.getElementById("year").textContent =
          now.getFullYear();

        app.classList.remove("hidden");
        loadingScreen.classList.add("hidden");

      } catch (error) {
        console.error("Assignment page access error:", error);

        await client.auth.signOut();

        showBlockingMessage(
          "Access verification failed",
          error.message || "Unable to verify moderator access."
        );
      }
    }

    document.getElementById("logoutButton")
      .addEventListener("click", async () => {

        const button = document.getElementById("logoutButton");

        button.disabled = true;
        button.textContent = "Signing out...";

        if (client) {
          await client.auth.signOut();
        }

        window.location.replace("login.html");
      });

    document.getElementById("date").textContent =
      new Date().toLocaleDateString("en-IN", {
        weekday: "long",
        day: "numeric",
        month: "long",
        year: "numeric"
      });

    verifyAccess();
  </script>

</body>
</html>
