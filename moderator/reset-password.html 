
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#252722">

  <title>Moderator Password Recovery | Lens Circle</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --paper: #f7f6f2;
      --white: #fff;
      --ink: #252722;
      --muted: #777970;
      --line: #e7e4dc;
      --accent: #a85e42;
      --accent-light: #f3e8e1;
      --serif: "Playfair Display", Georgia, serif;
      --sans: "DM Sans", Arial, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      background: var(--paper);
      color: var(--ink);
      font-family: var(--sans);
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .topbar {
      height: 76px;
      padding: 0 6%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: white;
      border-bottom: 1px solid var(--line);
    }

    .brand {
      font-family: var(--serif);
      font-size: 26px;
      font-weight: 700;
    }

    .brand span {
      color: var(--accent);
    }

    .back {
      color: var(--muted);
      font-size: 11px;
    }

    .main {
      min-height: calc(100vh - 76px);
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .visual {
      min-height: 650px;
      padding: 65px;
      display: flex;
      align-items: flex-end;
      color: white;
      background:
        linear-gradient(rgba(24,25,21,.28), rgba(24,25,21,.88)),
        url("https://images.unsplash.com/photo-1455390582262-044cdead277a?auto=format&fit=crop&w=1400&q=85")
        center/cover;
    }

    .visual-content {
      max-width: 460px;
    }

    .eyebrow {
      color: #d69a7e;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 18px;
    }

    .visual h1 {
      font-family: var(--serif);
      font-size: clamp(40px, 5vw, 60px);
      line-height: 1.1;
      font-weight: 500;
      margin-bottom: 20px;
    }

    .visual p {
      color: #e4e4dd;
      font-size: 12px;
      line-height: 1.9;
    }

    .panel {
      padding: 45px 25px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .card {
      width: 100%;
      max-width: 410px;
    }

    .label {
      display: inline-block;
      padding: 8px 11px;
      margin-bottom: 25px;
      background: var(--accent-light);
      color: var(--accent);
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 1.4px;
    }

    h2 {
      font-family: var(--serif);
      font-size: 39px;
      font-weight: 500;
      margin-bottom: 13px;
    }

    .description {
      margin-bottom: 30px;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.9;
    }

    .group {
      margin-bottom: 19px;
    }

    .group label {
      display: block;
      margin-bottom: 8px;
      font-size: 10px;
      font-weight: 700;
    }

    .group input {
      width: 100%;
      padding: 15px;
      border: 1px solid var(--line);
      outline: none;
      background: white;
      font-size: 12px;
    }

    .group input:focus {
      border-color: var(--accent);
    }

    .button {
      width: 100%;
      padding: 16px;
      border: 0;
      background: var(--ink);
      color: white;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
    }

    .button:hover {
      background: var(--accent);
    }

    .button:disabled {
      opacity: .6;
      cursor: not-allowed;
    }

    .status {
      display: none;
      margin-top: 17px;
      padding: 13px;
      font-size: 10px;
      line-height: 1.8;
      overflow-wrap: anywhere;
    }

    .status.error {
      display: block;
      background: #fff2ef;
      border: 1px solid #efd0c8;
      color: #a33c2c;
    }

    .status.success {
      display: block;
      background: #eff7ef;
      border: 1px solid #cfe2cf;
      color: #32633a;
    }

    .status.info {
      display: block;
      background: #fbf5e9;
      border: 1px solid #e9dcc2;
      color: #71532e;
    }

    .security {
      margin-top: 28px;
      padding: 17px;
      background: #f0eee8;
      color: #65665e;
      font-size: 10px;
      line-height: 1.8;
    }

    .footer {
      margin-top: 25px;
      text-align: center;
      color: var(--muted);
      font-size: 10px;
    }

    @media(max-width: 850px) {
      .main {
        grid-template-columns: 1fr;
      }

      .visual {
        min-height: 260px;
        padding: 35px;
      }

      .visual h1 {
        font-size: 39px;
      }

      .panel {
        padding: 45px 25px;
      }
    }

    @media(max-width: 480px) {
      .topbar {
        height: 66px;
        padding: 0 20px;
      }

      .brand {
        font-size: 23px;
      }

      h2 {
        font-size: 34px;
      }
    }
  </style>
</head>

<body>

  <header class="topbar">
    <a href="../index.html" class="brand">
      Lens <span>Circle</span>
    </a>

    <a href="login.html" class="back">
      ← Moderator sign in
    </a>
  </header>

  <main class="main">

    <section class="visual">
      <div class="visual-content">
        <div class="eyebrow">Account Security</div>

        <h1>Access restored. Responsibility continues.</h1>

        <p>
          Securely recover your moderator account and
          continue supporting the Lens Circle community.
        </p>
      </div>
    </section>

    <section class="panel">
      <div class="card">

        <div class="label">MODERATOR ACCOUNT RECOVERY</div>

        <h2>Reset your password.</h2>

        <p class="description">
          Enter the email address associated with your
          moderator account. If recovery is permitted,
          Supabase will send a secure recovery link.
        </p>

        <form id="recoveryForm">

          <div class="group">
            <label for="email">Account email</label>

            <input
              type="email"
              id="email"
              placeholder="moderator@example.com"
              autocomplete="email"
              maxlength="254"
              required>
          </div>

          <button class="button" id="submitButton" type="submit">
            Send recovery email →
          </button>

          <div
            class="status"
            id="status"
            role="status"
            aria-live="polite">
          </div>

        </form>

        <div class="security">
          <strong>Security reminder</strong><br>
          Only use the official Lens Circle recovery link.
          Never share your password or recovery link with
          another person. Recovery does not automatically
          grant moderator privileges.
        </div>

        <div class="footer">
          © <span id="year"></span> Lens Circle
        </div>

      </div>
    </section>

  </main>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <script>
    const SUPABASE_URL = "YOUR_SUPABASE_PROJECT_URL";
    const SUPABASE_ANON_KEY = "YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY";

    const configured =
      SUPABASE_URL.startsWith("https://") &&
      !SUPABASE_URL.includes("YOUR_SUPABASE") &&
      SUPABASE_ANON_KEY.length > 20 &&
      !SUPABASE_ANON_KEY.includes("YOUR_SUPABASE");

    const client = configured && window.supabase
      ? window.supabase.createClient(
          SUPABASE_URL,
          SUPABASE_ANON_KEY
        )
      : null;

    const form = document.getElementById("recoveryForm");
    const emailInput = document.getElementById("email");
    const button = document.getElementById("submitButton");
    const status = document.getElementById("status");

    function showStatus(message, type) {
      status.textContent = message;
      status.className = "status " + type;
    }

    form.addEventListener("submit", async event => {
      event.preventDefault();

      if (!client) {
        showStatus(
          "Supabase is not configured. Add your project URL and publishable/anon key.",
          "error"
        );
        return;
      }

      const email = emailInput.value.trim().toLowerCase();

      button.disabled = true;
      button.textContent = "Sending recovery email...";

      try {
        const redirectTo =
          window.location.origin +
          window.location.pathname.replace(
            "reset-password.html",
            "update-password.html"
          );

        const { error } = await client.auth.resetPasswordForEmail(
          email,
          {
            redirectTo
          }
        );

        if (error) throw error;

        showStatus(
          "If this address is eligible for recovery, an email will be sent. Check your inbox and spam folder.",
          "success"
        );

        form.reset();

      } catch (error) {
        showStatus(
          error.message || "Unable to process your recovery request.",
          "error"
        );

      } finally {
        button.disabled = false;
        button.textContent = "Send recovery email →";
      }
    });

    document.getElementById("year").textContent =
      new Date().getFullYear();
  </script>

</body>
</html>
