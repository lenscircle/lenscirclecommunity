
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#252722">
  <title>Directors & Departments | Lens Circle Admin</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    :root {
      --paper: #f7f6f2;
      --surface: #fff;
      --ink: #252722;
      --muted: #77796f;
      --line: #e8e6df;
      --accent: #a85e42;
      --accent-soft: #f5eae4;
      --dark: #252722;
      --radius: 15px;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font-family: "DM Sans", sans-serif;
    }

    a { color: inherit; text-decoration: none; }
    button, input, select { font: inherit; }

    .sidebar {
      position: fixed;
      inset: 0 auto 0 0;
      width: 255px;
      background: var(--dark);
      color: white;
      padding: 29px 19px;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      z-index: 20;
    }

    .brand {
      font-family: "Playfair Display", serif;
      font-size: 27px;
      letter-spacing: -.7px;
      padding: 0 12px;
    }

    .brand span { color: #d99a7d; }

    .portal-label {
      color: #aaa99f;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin: 8px 12px 30px;
    }

    .nav-label {
      color: #8e9087;
      font-size: 10px;
      letter-spacing: 1.8px;
      text-transform: uppercase;
      padding: 0 12px;
      margin: 19px 0 9px;
    }

    .nav a {
      display: block;
      color: #c5c5bd;
      padding: 10px 12px;
      margin: 3px 0;
      border-radius: 8px;
      font-size: 12px;
    }

    .nav a:hover, .nav a.active {
      color: white;
      background: #3a3c35;
    }

    .nav a.active { border-left: 3px solid #d18b6d; }

    .sidebar-bottom {
      margin-top: auto;
      border-top: 1px solid #41433c;
      padding: 18px 10px 0;
    }

    .sidebar-bottom a {
      display: block;
      color: #c5c5bd;
      font-size: 12px;
      margin: 12px 0;
    }

    .main {
      margin-left: 255px;
      padding: 35px 43px 60px;
      max-width: 1650px;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 34px;
    }

    .eyebrow {
      color: var(--accent);
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 9px;
    }

    h1, h2, h3, p { margin-top: 0; }

    h1 {
      font-family: "Playfair Display", serif;
      font-size: clamp(30px, 4vw, 42px);
      font-weight: 500;
      letter-spacing: -1px;
      margin-bottom: 8px;
    }

    .subtitle {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.7;
      margin-bottom: 0;
      max-width: 680px;
    }

    .admin-chip {
      display: flex;
      align-items: center;
      gap: 10px;
      background: white;
      border: 1px solid var(--line);
      border-radius: 40px;
      padding: 8px 15px 8px 8px;
      white-space: nowrap;
    }

    .avatar {
      width: 35px;
      height: 35px;
      border-radius: 50%;
      background: var(--accent-soft);
      color: var(--accent);
      display: grid;
      place-items: center;
      font-weight: 700;
    }

    .admin-chip strong { display: block; font-size: 12px; }
    .admin-chip small { color: var(--muted); font-size: 10px; }

    .notice {
      padding: 15px 18px;
      background: #f1eee7;
      border: 1px solid #e5e0d5;
      border-radius: 11px;
      color: #68685e;
      font-size: 11px;
      line-height: 1.7;
      margin-bottom: 25px;
    }

    .notice strong { color: var(--ink); }

    .section-heading {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 15px;
      margin: 30px 0 15px;
    }

    .section-heading h2 {
      font-family: "Playfair Display", serif;
      font-size: 23px;
      font-weight: 500;
      margin-bottom: 5px;
    }

    .section-heading p {
      color: var(--muted);
      font-size: 11px;
      margin-bottom: 0;
    }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }

    .summary-card {
      background: white;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 20px;
    }

    .summary-card span {
      display: block;
      color: var(--muted);
      font-size: 11px;
      margin-bottom: 14px;
    }

    .summary-card strong {
      font-family: "Playfair Display", serif;
      font-size: 31px;
      font-weight: 500;
    }

    .content-card {
      background: white;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 23px;
    }

    .departments-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 13px;
    }

    .department-card {
      border: 1px solid var(--line);
      background: #fdfcf9;
      border-radius: 11px;
      padding: 17px;
    }

    .department-card .number {
      color: var(--accent);
      font-family: "Playfair Display", serif;
      font-size: 24px;
      margin-bottom: 10px;
    }

    .department-card h3 {
      font-size: 12px;
      margin-bottom: 6px;
    }

    .department-card p {
      color: var(--muted);
      font-size: 10px;
      line-height: 1.6;
      margin-bottom: 0;
    }

    .table-wrap { overflow-x: auto; }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 650px;
    }

    th, td {
      text-align: left;
      padding: 14px 12px;
      border-bottom: 1px solid var(--line);
      font-size: 11px;
    }

    th {
      color: var(--muted);
      font-weight: 600;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: .7px;
    }

    td { color: #5d5e56; }

    .empty-state {
      padding: 32px 15px;
      border: 1px dashed #dcd9d0;
      background: #fcfbf8;
      border-radius: 10px;
      text-align: center;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.7;
    }

    .workflow-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }

    .workflow-card {
      background: white;
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 19px;
    }

    .workflow-card h3 {
      font-size: 12px;
      margin-bottom: 8px;
    }

    .workflow-card p {
      font-size: 10px;
      color: var(--muted);
      line-height: 1.7;
      margin-bottom: 0;
    }

    .footer {
      border-top: 1px solid var(--line);
      padding-top: 18px;
      margin-top: 30px;
      color: #96968c;
      font-size: 10px;
      line-height: 1.7;
    }

    .mobile-menu {
      display: none;
      border: 1px solid var(--line);
      background: white;
      padding: 9px 12px;
      border-radius: 8px;
      cursor: pointer;
    }

    @media (max-width: 1100px) {
      .departments-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 760px) {
      .sidebar {
        transform: translateX(-100%);
        transition: transform .25s ease;
      }

      .sidebar.open { transform: translateX(0); }
      .main { margin-left: 0; padding: 22px 17px 45px; }
      .mobile-menu { display: block; margin-bottom: 12px; }
      .topbar { align-items: flex-start; flex-wrap: wrap; }
      .admin-chip { margin-left: auto; }
      .workflow-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 520px) {
      .summary-grid { grid-template-columns: 1fr; }
      .departments-grid { grid-template-columns: 1fr; }
      .content-card { padding: 16px; }
    }
  </style>
</head>

<body>

<aside class="sidebar" id="sidebar">
  <div class="brand">Lens <span>Circle</span></div>
  <div class="portal-label">Administration</div>

  <nav class="nav">
    <div class="nav-label">Platform</div>
    <a href="dashboard.html">Overview</a>
    <a href="members.html">Members</a>

    <div class="nav-label">People & Leadership</div>
    <a href="directors.html" class="active">Directors & Departments</a>
    <a href="moderators.html">Moderators</a>

    <div class="nav-label">Creative Operations</div>
    <a href="competitions.html">Competitions</a>
    <a href="exhibitions.html">Exhibitions</a>
    <a href="stories.html">Stories & Editorial</a>

    <div class="nav-label">Growth & Business</div>
    <a href="partnerships.html">Partnerships</a>

    <div class="nav-label">Insights & Control</div>
    <a href="analytics.html">Platform Analytics</a>
    <a href="settings.html">Platform Settings</a>
  </nav>

  <div class="sidebar-bottom">
    <a href="../index.html">← Visit public website</a>
    <a href="#" id="signOut">Sign out</a>
  </div>
</aside>

<main class="main">

  <header class="topbar">
    <div>
      <button class="mobile-menu" id="menuButton" type="button">☰ Menu</button>
      <div class="eyebrow">Leadership administration</div>
      <h1>Directors & Departments</h1>
      <p class="subtitle">
        Appoint department leaders, manage leadership assignments
        and maintain the organisational structure of Lens Circle.
      </p>
    </div>

    <div class="admin-chip">
      <div class="avatar" id="adminAvatar">A</div>
      <div>
        <strong id="adminName">Administrator</strong>
        <small>Platform Admin</small>
      </div>
    </div>
  </header>

  <div class="notice">
    <strong>Admin authority:</strong>
    Only Admin can appoint, remove or reassign Directors. Directors
    can manage Moderators only within their own assigned departments.
    All appointment and permission changes must be performed through
    protected backend functions.
  </div>

  <div class="section-heading">
    <div>
      <h2>Leadership overview</h2>
      <p>Current appointment information from the protected staff registry.</p>
    </div>
  </div>

  <section class="summary-grid">
    <article class="summary-card">
      <span>Active Directors</span>
      <strong>—</strong>
    </article>

    <article class="summary-card">
      <span>Departments</span>
      <strong>5</strong>
    </article>

    <article class="summary-card">
      <span>Pending appointments</span>
      <strong>—</strong>
    </article>
  </section>

  <div class="section-heading">
    <div>
      <h2>Department structure</h2>
      <p>Five proposed leadership departments within Lens Circle.</p>
    </div>
  </div>

  <section class="content-card">
    <div class="departments-grid">

      <article class="department-card">
        <div class="number">01</div>
        <h3>Competition Director</h3>
        <p>
          Oversees photography competitions, judging operations,
          competition moderators and entry workflows.
        </p>
      </article>

      <article class="department-card">
        <div class="number">02</div>
        <h3>Community Director</h3>
        <p>
          Oversees member experience, community moderation,
          guidelines and community engagement.
        </p>
      </article>

      <article class="department-card">
        <div class="number">03</div>
        <h3>Activities Director</h3>
        <p>
          Leads Photo of the Day, weekly challenges, photography
          battles and community activities.
        </p>
      </article>

      <article class="department-card">
        <div class="number">04</div>
        <h3>Editorial Director</h3>
        <p>
          Oversees stories, photography features, magazine content
          and editorial publishing.
        </p>
      </article>

      <article class="department-card">
        <div class="number">05</div>
        <h3>Outreach Director</h3>
        <p>
          Leads community growth, creator outreach, collaborations
          and external relationships.
        </p>
      </article>

    </div>
  </section>

  <div class="section-heading">
    <div>
      <h2>Director appointments</h2>
      <p>Live records will appear after database integration.</p>
    </div>
  </div>

  <section class="content-card">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Director</th>
            <th>Email</th>
            <th>Department</th>
            <th>Appointment status</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          <tr>
            <td colspan="5">
              <div class="empty-state">
                <strong>No Director records connected</strong><br>
                Director accounts and department assignments will appear
                here once the protected staff registry is implemented.
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <div class="section-heading">
    <div>
      <h2>Appointment workflow</h2>
      <p>How Director appointments will operate.</p>
    </div>
  </div>

  <section class="workflow-grid">
    <article class="workflow-card">
      <h3>01 · Select an account</h3>
      <p>
        Admin selects an eligible existing account or securely provisions
        a new staff account. The person must not self-assign a privileged role.
      </p>
    </article>

    <article class="workflow-card">
      <h3>02 · Assign departments</h3>
      <p>
        Admin assigns one or more approved departments. Multiple department
        assignments require explicit Admin authorisation.
      </p>
    </article>

    <article class="workflow-card">
      <h3>03 · Confirm appointment</h3>
      <p>
        A protected backend operation records the appointment,
        permissions, status and audit event.
      </p>
    </article>
  </section>

  <div class="notice">
    <strong>Security requirement:</strong>
    Do not implement appointment actions using client-side
    <code>user_metadata</code> or direct browser updates to privileged
    role tables. Use an Admin-authorised database function or trusted
    server-side provisioning process, with audit logging and RLS.
  </div>

  <footer class="footer">
    Lens Circle · Leadership Administration<br>
    Director appointments are controlled exclusively by authorised Admin accounts.
  </footer>

</main>

<script>
  const SUPABASE_URL = "YOUR_SUPABASE_PROJECT_URL";
  const SUPABASE_ANON_KEY = "YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY";

  const { createClient } = supabase;
  const db = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

  document.getElementById("menuButton").addEventListener("click", () => {
    document.getElementById("sidebar").classList.toggle("open");
  });

  async function verifyAdmin() {
    try {
      const { data: sessionData, error: sessionError } =
        await db.auth.getSession();

      if (sessionError || !sessionData.session) {
        window.location.replace("login.html");
        return;
      }

      const { data: authorised, error: roleError } =
        await db.rpc("has_staff_role", {
          required_role: "admin"
        });

      if (roleError || authorised !== true) {
        await db.auth.signOut();
        window.location.replace("login.html");
        return;
      }

      const user = sessionData.session.user;
      const name =
        user.user_metadata?.full_name ||
        user.user_metadata?.name ||
        "Administrator";

      document.getElementById("adminName").textContent = name;
      document.getElementById("adminAvatar").textContent =
        name.trim().charAt(0).toUpperCase() || "A";

    } catch (error) {
      console.error("Admin verification failed:", error);
      await db.auth.signOut();
      window.location.replace("login.html");
    }
  }

  document.getElementById("signOut").addEventListener("click", async event => {
    event.preventDefault();

    const { error } = await db.auth.signOut();

    if (error) {
      alert("Unable to sign out. Please try again.");
      return;
    }

    window.location.replace("login.html");
  });

  verifyAdmin();
</script>

</body>
